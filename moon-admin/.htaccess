# PORTAL 4: Admin
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Send All Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<!-- # Optional: Restrict Admin Panel to your specific IP address for ultimate security
# Uncomment the lines below and add your IP
# Order Deny,Allow
# Deny from All -->
<!-- # Allow from 192.168.1.100 -->